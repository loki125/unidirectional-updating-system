# ====== Environment variables for Isolated containers====

# Mongo
MONGO_ISOLATED_PORT=27017
MONGO_ISOLATED_URI=mongodb://mongo-isolated:27017
MONGO_ISOLATED_REPLICA_URI=mongodb://mongo-isolated:27017/?replicaSet=rs0

MONGO_PACKAGES_DB=packages_db
MONGO_PACKAGES_COLLECTION=packages

MONGO_REPORTS_DB=reports_db
MONGO_REPORTS_COLLECTION=reports

# Distributor
DISTRIBUTOR_PATH=../../core/store-node/distributor
DISTRIBUTOR_PORT=11080

# Store manager
STORE_MANAGER_PATH=../../core/store-node/store-manager

#system-view
VIEW_PATH=../../core/sys-view
VIEW_UDP_PORT=5005
VIEW_APP_PORT=9090
VIEW_IP=172.30.2.3

# Paths inside containers
STORE_PATH=/data/store_volume
UPDATES_PATH=/data/updates_volume

# Network
NETWORK=192.168.50.0
NETNAME=isolated_network
SUBNET=255.255.255.0

# ====== Environment variables for Outside containers ======

FLUTE_PORT=40085
MULTICAST_IP=238.1.1.95

UPDATE_MANAGER_PATH=../../core/update-manager
UPDATE_MANAGER_PORT=8080

# ====== Environment variables for Networking ======
ROUTER_PATH=../router

ROUTER_OUTSIDE_IP="172.30.0.254"
ROUTER_VIEW_IP="172.30.2.254"
ROUTER_MCAST_IP="172.30.1.2"
STORE_MANAGER_MCAST_IP="172.30.1.3"
